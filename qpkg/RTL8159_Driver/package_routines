######################################################################
# Package routines for RTL8159 USB Ethernet Driver
######################################################################

DRIVER_FILE="r8152.ko"
SERVICE_FILE="RTL8159_Driver.sh"
INSTALL_LOG="${SYS_QPKG_DIR}/install.log"

routine_module_field() {
    RTL8159_ROUTINE_FIELD="$1"
    RTL8159_ROUTINE_MODULE="$2"
    RTL8159_ROUTINE_VALUE=""

    if command -v modinfo >/dev/null 2>&1; then
        RTL8159_ROUTINE_VALUE=$(modinfo -F "${RTL8159_ROUTINE_FIELD}" "${RTL8159_ROUTINE_MODULE}" 2>/dev/null | head -1)
    fi

    if [ -z "${RTL8159_ROUTINE_VALUE}" ] && command -v strings >/dev/null 2>&1; then
        RTL8159_ROUTINE_VALUE=$(strings "${RTL8159_ROUTINE_MODULE}" 2>/dev/null |
            sed -n "s/^${RTL8159_ROUTINE_FIELD}=//p" | head -1)
    fi

    printf '%s\n' "${RTL8159_ROUTINE_VALUE}"
}

routine_loaded_srcversion() {
    if [ -r /sys/module/r8152/srcversion ]; then
        tr -d '\r\n' < /sys/module/r8152/srcversion
    fi
}

routine_module_loaded() {
    lsmod 2>/dev/null | grep -q '^r8152[[:space:]]'
}

routine_stock_path() {
    RTL8159_ROUTINE_KERNEL=$(uname -r)
    RTL8159_ROUTINE_MODULE_DIR="/lib/modules/${RTL8159_ROUTINE_KERNEL}"
    RTL8159_ROUTINE_STOCK_PATH=""

    if command -v modinfo >/dev/null 2>&1; then
        RTL8159_ROUTINE_STOCK_PATH=$(modinfo -n r8152 2>/dev/null | head -1)
        case "${RTL8159_ROUTINE_STOCK_PATH}" in
            ""|"(builtin)")
                RTL8159_ROUTINE_STOCK_PATH=""
                ;;
            /*)
                ;;
            *)
                RTL8159_ROUTINE_STOCK_PATH="${RTL8159_ROUTINE_MODULE_DIR}/${RTL8159_ROUTINE_STOCK_PATH}"
                ;;
        esac
    fi

    if [ -z "${RTL8159_ROUTINE_STOCK_PATH}" ] &&
       [ -r "${RTL8159_ROUTINE_MODULE_DIR}/modules.dep" ]; then
        RTL8159_ROUTINE_STOCK_PATH=$(awk -F: '$1 ~ /(^|\/)r8152\.ko(\.(xz|gz|zst))?$/ { print $1; exit }' "${RTL8159_ROUTINE_MODULE_DIR}/modules.dep")
        if [ -n "${RTL8159_ROUTINE_STOCK_PATH}" ]; then
            case "${RTL8159_ROUTINE_STOCK_PATH}" in
                /*) ;;
                *) RTL8159_ROUTINE_STOCK_PATH="${RTL8159_ROUTINE_MODULE_DIR}/${RTL8159_ROUTINE_STOCK_PATH}" ;;
            esac
        fi
    fi

    if [ -z "${RTL8159_ROUTINE_STOCK_PATH}" ]; then
        RTL8159_ROUTINE_STOCK_PATH=$(find "${RTL8159_ROUTINE_MODULE_DIR}" \( -name 'r8152.ko' -o -name 'r8152.ko.xz' -o -name 'r8152.ko.gz' -o -name 'r8152.ko.zst' \) 2>/dev/null | head -1)
    fi

    if [ -n "${RTL8159_ROUTINE_STOCK_PATH}" ] &&
       [ ! -r "${RTL8159_ROUTINE_STOCK_PATH}" ]; then
        RTL8159_ROUTINE_STOCK_PATH=""
    fi

    printf '%s\n' "${RTL8159_ROUTINE_STOCK_PATH}"
}

restore_stock_before_upgrade() {
    RTL8159_OLD_DRIVER="${SYS_QPKG_DIR}/${DRIVER_FILE}"
    [ -r "${RTL8159_OLD_DRIVER}" ] || return 0
    routine_module_loaded || return 0

    RTL8159_OLD_SRC=$(routine_module_field srcversion "${RTL8159_OLD_DRIVER}")
    RTL8159_ACTIVE_SRC=$(routine_loaded_srcversion)

    # Only touch the active module when it is positively identified as the
    # previous QPKG copy. A stock or unknown module is left untouched.
    if [ -z "${RTL8159_OLD_SRC}" ] || [ "${RTL8159_ACTIVE_SRC}" != "${RTL8159_OLD_SRC}" ]; then
        return 0
    fi

    RTL8159_STOCK_PATH=$(routine_stock_path)
    RTL8159_STOCK_SRC=$(routine_module_field srcversion "${RTL8159_STOCK_PATH}")
    RTL8159_STOCK_VERMAGIC=$(routine_module_field vermagic "${RTL8159_STOCK_PATH}")
    RTL8159_STOCK_KERNEL=${RTL8159_STOCK_VERMAGIC%% *}

    if [ -z "${RTL8159_STOCK_PATH}" ] ||
       [ -z "${RTL8159_STOCK_SRC}" ] ||
       [ "${RTL8159_STOCK_KERNEL}" != "$(uname -r)" ]; then
        err_log "Cannot verify the stock r8152 module before upgrading; the active QPKG driver was left loaded."
    fi

    log "Restoring the stock r8152 module before replacing QPKG files."
    if ! rmmod r8152 2>/dev/null; then
        err_log "Could not unload the previous QPKG r8152 module."
    fi

    if modprobe r8152 2>/dev/null &&
       [ "$(routine_loaded_srcversion)" = "${RTL8159_STOCK_SRC}" ]; then
        log "Verified stock r8152 module restored."
        return 0
    fi

    if routine_module_loaded; then
        rmmod r8152 2>/dev/null || true
    fi

    case "${RTL8159_STOCK_PATH}" in
        *.ko)
            if insmod "${RTL8159_STOCK_PATH}" 2>/dev/null &&
               [ "$(routine_loaded_srcversion)" = "${RTL8159_STOCK_SRC}" ]; then
                log "Verified stock r8152 module restored from its absolute path."
                return 0
            fi
            ;;
    esac

    # Keep the NAS usable if stock restoration unexpectedly fails.
    if routine_module_loaded; then
        rmmod r8152 2>/dev/null || true
    fi
    if insmod "${RTL8159_OLD_DRIVER}" 2>/dev/null &&
       [ "$(routine_loaded_srcversion)" = "${RTL8159_OLD_SRC}" ]; then
        warn_log "Stock restore failed; the previous QPKG driver was put back before aborting."
    elif routine_module_loaded; then
        rmmod r8152 2>/dev/null || true
    fi
    err_log "Could not restore the verified stock r8152 module; upgrade aborted."
}

run_service() {
    RTL8159_ROUTINE_ACTION="$1"
    RTL8159_ROUTINE_SERVICE="${SYS_QPKG_DIR}/${SERVICE_FILE}"

    if [ ! -x "${RTL8159_ROUTINE_SERVICE}" ]; then
        return 1
    fi

    RTL8159_QPKG_ROOT="${SYS_QPKG_DIR}" RTL8159_SKIP_ENABLE_CHECK=TRUE "${RTL8159_ROUTINE_SERVICE}" "${RTL8159_ROUTINE_ACTION}" >> "${INSTALL_LOG}" 2>&1
}

pkg_pre_install(){
    log "RTL8159 pre-install: preserving the stock /lib/modules driver."
    restore_stock_before_upgrade
}

pkg_install(){
    if [ "${SYS_CPU_ARCH}" != "x86_64" ]; then
        err_log "Unsupported architecture: ${SYS_CPU_ARCH}; x86_64 is required."
    fi

    if [ ! -f "${SYS_QPKG_DIR}/${DRIVER_FILE}" ] &&
       [ -f "${SYS_QPKG_DIR}/x86_64/${DRIVER_FILE}" ]; then
        mv "${SYS_QPKG_DIR}/x86_64/${DRIVER_FILE}" "${SYS_QPKG_DIR}/"
    fi

    if [ ! -r "${SYS_QPKG_DIR}/${DRIVER_FILE}" ]; then
        err_log "Packaged driver not found in ${SYS_QPKG_DIR}."
    fi

    if [ ! -f "${SYS_QPKG_DIR}/${SERVICE_FILE}" ]; then
        err_log "QPKG service script not found in ${SYS_QPKG_DIR}."
    fi
    chmod 755 "${SYS_QPKG_DIR}/${SERVICE_FILE}"

    : > "${INSTALL_LOG}"
    if ! run_service validate; then
        err_log "Driver validation failed. The running module was not changed; see ${INSTALL_LOG}."
    fi

    log "Driver architecture, vermagic and srcversion metadata validated."
}

pkg_post_install(){
    if ! run_service cleanup; then
        err_log "Legacy auto-load entries could not be removed safely. The active module was not replaced; see ${INSTALL_LOG}."
    fi

    if [ "${SYS_QPKG_SERVICE_ENABLED}" = "TRUE" ]; then
        if run_service start; then
            RTL8159_START_STATUS=0
        else
            RTL8159_START_STATUS=$?
        fi
        case "${RTL8159_START_STATUS}" in
            0)
                log "Verified QPKG r8152 driver loaded successfully."
                ;;
            1)
                SYS_QPKG_SERVICE_ENABLED=FALSE
                warn_log "QPKG driver was not activated; the existing or restored stock module remains safe and the package will stay disabled. See ${INSTALL_LOG}."
                ;;
            *)
                err_log "QPKG driver activation failed and no verified fallback could be loaded. See ${INSTALL_LOG}."
                ;;
        esac
    else
        log "Package is disabled; validated driver was installed without changing the active module."
    fi
}

# QDK inlines these snippets into .uninstall.sh. Keep the pre-remove guard
# self-contained: functions from this file do not exist in the generated script.
PKG_PRE_REMOVE="{
    if [ ! -x \"${SYS_QPKG_DIR}/${SERVICE_FILE}\" ]; then
        echo \"ERROR: QPKG service script is missing; refusing unsafe removal.\" >&2
        exit 1
    fi
    RTL8159_QPKG_ROOT=\"${SYS_QPKG_DIR}\" RTL8159_SKIP_ENABLE_CHECK=TRUE \"${SYS_QPKG_DIR}/${SERVICE_FILE}\" remove || {
        echo \"ERROR: Stock r8152 module could not be restored; QPKG files were kept.\" >&2
        exit 1
    }
}"

PKG_MAIN_REMOVE=""
PKG_POST_REMOVE=""
